{
  cfg,
  lix,
  paths,
  entryAfter,
  pkgs,
  controller,
  hooks,
  ...
}: let
  inherit (lix.attrsets.aggregation) recursiveUpdate;
  inherit (lix.attrsets.transformation) mapAttrsToList;
  inherit (lix.debug.assertions) withContext;
  inherit (lix.lists.transformation) imap1;
  inherit (lix.sources.access) getExe';
  inherit
    (lix.strings.construction)
    concatStringsSep
    fromBool
    optionalString
    toJSON
    ;
  inherit (lix.strings.predicates) hasInfix;
  inherit (lix.strings.transformation) escapeShellArg;
  inherit (lix.types.predicates) isBool isFloat isInt;
  inherit (pkgs) writeText makeWrapper symlinkJoin;
  inherit (lix.toolkit.binaries) install0644 rm sd tr;

  api.placeholders = {
    wallhaven = "@WALLHAVEN_API_KEY@";
  };

  package = cfg.package.overrideAttrs (previous: {
    patches = (previous.patches or []) ++ [./favorites-notification.patch];
  });

  render = {
    settings,
    sources,
    filters,
  }: let
    # Variety reads variety.conf with ConfigObj: unquoted values are fine,
    # except that a comma makes a list and an empty value needs quotes.
    prep = arg:
      if isBool arg
      then fromBool arg
      else if isInt arg || isFloat arg
      then toJSON arg
      else if arg == "" || hasInfix "," arg
      then
        assert withContext {
          name = "mkSource";
          context = "validating mkSource value";
          assertion = !(hasInfix "\"" arg);
          message = "variety.conf value cannot contain a double quote: ${arg}";
        }; ''"${arg}"''
      else arg;

    scalars = settings: concatStringsSep "\n" (mapAttrsToList (key: val: "${key} = ${prep val}") settings);
    sourceLine = input: source: "src${toString input} = ${
      concatStringsSep "|" (
        with source; [
          (fromBool enable)
          type
          location
        ]
      )
    }";
    filterLine = input: slice: "filter${toString input} = ${
      concatStringsSep "|" (
        with slice; [
          (fromBool enable)
          name
          args
        ]
      )
    }";
  in ''
    # Generated by the Variety Nix module. Edit the Nix module, not this file.
    ${scalars settings}

    [sources]
    ${concatStringsSep "\n" (imap1 sourceLine sources)}

    [filters]
    ${concatStringsSep "\n" (imap1 filterLine filters)}
  '';

  conf = let
    generated = writeText "variety.conf" (render {
      settings = let
        defined = cfg.extraSettings;
        derived = {
          inherit (cfg) icon;
          change_enabled = cfg.change.enable;
          change_interval = cfg.change.interval;
          change_lock_screen = cfg.lockScreen;
          change_on_start = cfg.change.onStart;
          clipboard_enabled = cfg.clipboard.enable;
          clipboard_hosts = concatStringsSep "," cfg.clipboard.hosts;
          clipboard_use_whitelist = cfg.clipboard.useWhitelist;
          clock_date_font = cfg.clock.date.font;
          clock_enabled = cfg.clock.enable;
          clock_filter = cfg.clock.filter;
          clock_font = cfg.clock.font;
          copyto_enabled = cfg.copyTo.enable;
          copyto_folder = cfg.copyTo.folder;
          desired_color = cfg.constraints.desiredColor.value;
          desired_color_enabled = cfg.constraints.desiredColor.enable;
          download_folder = cfg.folders.downloaded;
          download_preference_ratio = cfg.downloadPreferenceRatio;
          favorites_folder = cfg.folders.preferred;
          favorites_operations = cfg.features.preferred.operations;
          fetched_folder = cfg.folders.fetched;
          get_wallpaper_script = hooks.getWallpaper;
          internet_enabled = cfg.internet;
          lightness_enabled = cfg.constraints.lightness.enable;
          lightness_mode = cfg.constraints.lightness.mode;
          min_rating = cfg.constraints.minRating.value;
          min_rating_enabled = cfg.constraints.minRating.enable;
          min_size = cfg.constraints.minSize.value;
          min_size_enabled = cfg.constraints.minSize.enable;
          name_regex = cfg.constraints.nameRegex.value;
          name_regex_enabled = cfg.constraints.nameRegex.enable;
          quota_enabled = cfg.quota.enable;
          quota_size = cfg.quota.size;
          quotes_authors = cfg.quotes.authors;
          quotes_bg_color = cfg.quotes.background.color;
          quotes_bg_opacity = cfg.quotes.background.opacity;
          quotes_change_enabled = cfg.quotes.change.enable;
          quotes_change_interval = cfg.quotes.change.interval;
          quotes_disabled_sources = cfg.quotes.disabledSources;
          quotes_enabled = cfg.quotes.enable;
          quotes_favorites_file = cfg.quotes.preferred.file;
          quotes_favorites_format = cfg.quotes.preferred.format;
          quotes_font = cfg.quotes.font;
          quotes_hpos = cfg.quotes.position.horizontal;
          quotes_max_length = cfg.quotes.maxLength;
          quotes_tags = cfg.quotes.tags;
          quotes_text_color = cfg.quotes.text.color;
          quotes_text_shadow = cfg.quotes.text.shadow;
          quotes_vpos = cfg.quotes.position.vertical;
          quotes_width = cfg.quotes.width;
          safe_mode = cfg.safeMode;
          set_wallpaper_script = hooks.setWallpaper;
          set_lock_screen_script = hooks.setLockscreen;
          slideshow_custom_enabled = cfg.slideshow.custom.enable;
          slideshow_custom_folder = cfg.slideshow.custom.folder;
          slideshow_downloads_enabled = cfg.slideshow.downloads.enable;
          slideshow_fade = cfg.slideshow.fade;
          slideshow_favorites_enabled = cfg.slideshow.preferred.enable;
          slideshow_mode = cfg.slideshow.mode;
          slideshow_monitor = cfg.slideshow.monitor;
          slideshow_pan = cfg.slideshow.pan;
          slideshow_seconds = cfg.slideshow.seconds;
          slideshow_sort_order = cfg.slideshow.sortOrder;
          slideshow_sources_enabled = cfg.slideshow.sources.enable;
          slideshow_zoom = cfg.slideshow.zoom;
          smart_enabled = cfg.features.smart.enable;
          smart_notice_shown = cfg.features.smart.noticeShown;
          smart_register_shown = cfg.features.smart.registerShown;
          stats_enabled = cfg.stats;
          stats_notice_shown = cfg.features.stats.noticeShown;
          sync_enabled = cfg.sync;
          use_landscape_enabled = cfg.constraints.landscape.enable;
          wallhaven_api_key = optionalString (cfg.wallhaven.apiKeyFile != null) api.placeholders.wallhaven;
          wallpaper_auto_rotate = cfg.autoRotate;
          wallpaper_display_mode = cfg.displayMode;
        };
      in
        recursiveUpdate derived defined;
      inherit (cfg) sources filters;
    });

    activation = let
      destination = escapeShellArg paths.variety.files.config;
      script = ''
        run ${install0644} ${generated} ${destination}
        ${optionalString (cfg.wallhaven.apiKeyFile != null) ''
          if [ -z "''${DRY_RUN:-}" ]; then
            key="$(${tr} -d '\n' < ${escapeShellArg cfg.wallhaven.apiKeyFile})"
            ${sd} --fixed-strings ${escapeShellArg api.placeholders.wallhaven} "$key" ${destination}
          fi
        ''}
      '';
    in
      if cfg.seed.mode == "overwrite"
      then script
      else "if [ -e ${destination} ]; then :; else ${script}; fi";
  in {
    inherit generated activation;
  };
in {
  home = {
    packages =
      [
        (
          # With a named profile, wrap the binary so every call (keybinds, the
          # varietyctl actions, the desktop entry) hits that profile.
          let
            binary = getExe' package "variety";
          in
            if cfg.profile.name == null
            then package
            else
              symlinkJoin {
                name = "variety-profiled";
                paths = [package];
                nativeBuildInputs = [makeWrapper];
                postBuild = ''
                  ${rm} $out/bin/variety
                  makeWrapper ${binary} $out/bin/variety --add-flags ${escapeShellArg "--profile ${escapeShellArg cfg.profile.path}"}
                '';
                meta =
                  (package.meta or {})
                  // {
                    mainProgram = "variety";
                  };
              }
        )
      ]
      ++ [controller];

    sessionVariables = {
      WALLPAPER_VARIETY_PROFILE = cfg.profile.path;
      WALLPAPER_VARIETY_CONFIG = paths.variety.files.config;
      WALLPAPER_VARIETY_DOWNLOADED = cfg.folders.downloaded;
      WALLPAPER_VARIETY_FETCHED = cfg.folders.fetched;
      WALLPAPER_VARIETY_FAVORITES = cfg.folders.preferred;
    };

    activation = {
      varietyProfile = entryAfter ["writeBoundary"] conf.activation;
    };
  };
}
