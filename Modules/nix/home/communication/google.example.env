# Copy to ~/.config/thunderbird/google.env and chmod 600 before editing.
# Values are literal text, optionally enclosed in matching quotes.
# List values correspond by position. Use GOOGLE_EMAIL/GOOGLE_REAL_NAME for one account.
GOOGLE_EMAILS=primary@gmail.com,secondary@gmail.com
GOOGLE_REAL_NAMES=Primary Name,Secondary Name
# Reuses saved Khal discovery for a matching account, when available.
# Otherwise add calendars using Thunderbird's native Find Calendars.
