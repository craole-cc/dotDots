# Copy to ~/.config/thunderbird/google.env and chmod 600 before editing.
# Values are literal text, optionally enclosed in matching quotes.
# Use GOOGLE_EMAIL for one account or GOOGLE_EMAILS for several, comma-separated.
GOOGLE_EMAILS=primary@gmail.com,secondary@gmail.com
GOOGLE_REAL_NAME=FIXME
# Optional extra calendar IDs for the first account; other accounts use their own email.
GOOGLE_CALENDAR_IDS=
