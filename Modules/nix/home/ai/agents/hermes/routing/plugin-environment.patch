+def _publish_nix_selection(change) -> bool:
+    """Commit dependency-free plugin changes without rebuilding Nix's environment."""
+    import json
+    from hermes_cli.runtime_state import finish_publication, recover_publication
+    from pm import receipt
+
+    if change is None:
+        return False
+    stamp = paths.install_stamp_path(paths.repo_root())
+    if not stamp.is_file() or json.loads(stamp.read_text(encoding="utf-8")).get("distribution") != "nix":
+        return False
+    if change.members:
+        raise InstallError(
+            "venv", "plugin selection requires Python package installation in a Nix-managed environment",
+            "declare plugin Python dependencies and enable the plugin through Nix, then rebuild Hermes",
+        )
+    try:
+        change.publish(paths.repo_root())
+        finish_publication(paths.repo_root())
+    except BaseException:
+        recover_publication(paths.repo_root())
+        raise
+    receipt.record_venv_rebuild(False, "Nix environment retained; no plugin Python packages")
+    return True
+
+
