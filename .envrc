#!/bin/sh

if command -v nix > /dev/null 2>&1 && [ -f flake.nix ]; then
  _has_lorri="$(command -v lorri 2> /dev/null || :)"
  case "${DIRENV_IN_ENVRC:-}" in "")
    if [ -n "${_has_lorri}" ]; then
      _lorri_env="$(lorri hook bash 2> /dev/null)" || _lorri_env=""
      case "${_lorri_env}" in
        "") printf "[INFO] %s\n" \
          "lorri: no completed evaluation yet; daemon is building in the background" ;;
        *)
          # shellcheck disable=SC2312
          eval "${_lorri_env}"
          printf "[INFO] %s\n" \
            "lorri: loaded cached evaluation into this shell"
          ;;
      esac
    fi
    ;;
  *)
    if [ -n "${_has_lorri}" ]; then
      # shellcheck disable=SC2312
      eval "$(lorri direnv)"
    else
      use flake
    fi
    return 0
    ;;
  esac
else
  #~@ Source the dotfiles poly-RC's POSIX block for PATH/env setup.
  dotsrc="${PWD}/.dotsrc"
  if [ -f "${dotsrc}" ]; then
    # shellcheck disable=SC1090
    . "${dotsrc}"
  else
    printf "[ERROR]: %s %s.\n" \
      ".dotsrc not found at" "${dotsrc}" >&2
    return 1
  fi
fi
