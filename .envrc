#!/bin/sh

# Resolve the dotDots checkout from filesystem markers rather than Git state.
# direnv may reload while an older Nix shell still exports a stale DOTS, so
# establish the current checkout unconditionally before deciding whether the
# profile itself needs to load the flake.
_dots_dir="${PWD:-.}"
_dots_dir="$(cd "${_dots_dir}" 2>/dev/null && pwd -P)" || return 1

while :; do
  if [ -f "${_dots_dir}/flake.nix" ] \
    && [ -f "${_dots_dir}/profile" ] \
    && [ -d "${_dots_dir}/API/nix" ] \
    && [ -d "${_dots_dir}/Modules/nix" ] \
    && [ -d "${_dots_dir}/Libraries/nix" ]; then
    DOTS="${_dots_dir}"
    break
  fi

  if [ "${_dots_dir}" = "/" ]; then
    printf 'direnv: unable to resolve dotDots root from %s\n' "${PWD:-}" >&2
    return 1
  fi

  _dots_parent="${_dots_dir%/*}"
  [ -n "${_dots_parent}" ] || _dots_parent="/"
  [ "${_dots_parent}" != "${_dots_dir}" ] || return 1
  _dots_dir="${_dots_parent}"
done

export DOTS
unset _dots_dir _dots_parent

case "${IN_NIX_SHELL:-}" in
"")
  DOTS_INIT_COMMAND="load-flake"
  export DOTS_INIT_COMMAND
  . "${DOTS}/profile"
  ;;
*) ;;
esac
