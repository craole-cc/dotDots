#!/bin/sh

if command -v nix >/dev/null 2>&1 && [ -f flake.nix ]; then
  #> Contributor hosts get the dev shell, every other host keeps the default (core).
  #? Compared in lowercase so Victus, QBX and Preci match however `hostname` cases them.
  case "$(hostname | tr '[:upper:]' '[:lower:]')" in
  victus | qbx | preci) _flake=".#dev" ;;
  *) _flake="." ;;
  esac

  _has_lorri="$(command -v lorri 2>/dev/null || :)"
  case "${DIRENV_IN_ENVRC:-}" in
  "") ;;
  *)
    if [ -n "${_has_lorri}" ]; then
      # shellcheck disable=SC2312
      eval "$(lorri direnv)"
    else
      use flake "${_flake}"
    fi
    return 0
    ;;
  esac
else
  #~@ Source the dotfiles poly-RC's POSIX block for PATH/env setup.
  dotsrc="${PWD}/.dotsrc"
  if [ -f "${dotsrc}" ]; then
    # shellcheck disable=SC1090
    . "${dotsrc}"
  else
    printf "[ERROR]: %s %s.\n" \
      ".dotsrc not found at" "${dotsrc}" >&2
    return 1
  fi
fi
