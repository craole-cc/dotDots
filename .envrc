#!/bin/sh

if command -v nix > /dev/null 2>&1 && [ -f flake.nix ]; then
  _host="$(hostname)"
  case "$(printf '%s' "${_host}" | tr '[:upper:]' '[:lower:]')" in
    victus | qbx | preci) _flake=".#${_host}-dev" ;;
    *) _flake="." ;;
  esac

  if command -v lorri > /dev/null 2>&1; then
    # shellcheck disable=SC2312
    eval "$(lorri direnv --flake "${_flake}")"
  else
    watch_dir Modules/nix/global
    use flake "${_flake}"
  fi
else
  dotsrc="${PWD}/.dotsrc"
  if [ -f "${dotsrc}" ]; then
    # shellcheck disable=SC1090
    . "${dotsrc}"
  else
    printf "[ERROR]: %s %s.\n" ".dotsrc not found at" "${dotsrc}" >&2
    return 1
  fi
fi
