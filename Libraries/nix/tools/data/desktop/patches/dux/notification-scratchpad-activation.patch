+
+            const appEntry = DesktopEntries.heuristicLookup(appId);
+            const appIds = [normalizeDesktopId(appId), normalizeDesktopId(appEntry?.id)].filter(Boolean);
+            if (!notificationIds.some(id => appIds.includes(id)))
+                continue;
+
+            const specialName = specialWorkspaceName(toplevel);
+            if (!specialName)
+                continue;
+
+            const alreadyVisible = (Hyprland.monitors?.values || []).some(monitor => hyprlandVisibleSpecialWorkspaceOnScreen(monitor.name) === specialName);
+            if (!alreadyVisible)
+                HyprlandService.toggleSpecial(specialName);
+
+            Qt.callLater(() => activateToplevel(toplevel));
+            return true;
+        }
+
