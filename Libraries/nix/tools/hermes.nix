_: {
  mkProfileValidator = toolkit: let
    inherit (toolkit.platforms.rustPlatform) buildRustPackage;
    inherit (toolkit.builders) runCommand;
    inherit (toolkit.binaries) rust-script;
    inherit (toolkit.write) posixBin text;

    #~@ Shared Identity
    name = "hermes-profile-validate";
    version = "0.1.0";
    edition = "2021";
    script = ./hermes-profile.rs;

    #~@ Build Inputs (derivations, not shell)
    #? Interpolated TOML values are quoted; text keeps heredoc indentation out of the generated files.
    cargo = {
      toml = text "Cargo.toml" ''
        [package]
        name = "${name}"
        version = "${version}"
        edition = "${edition}"

        [[bin]]
        name = "${name}"
        path = "src/main.rs"

        [profile.release]
        strip = true
        lto = true
        panic = "abort"
        codegen-units = 1
        opt-level = "z"
      '';

      #? Zero external crates -> trivial lockfile -> fully offline build.
      lock = text "Cargo.lock" ''
        # This file is automatically @generated by Cargo.
        # It is not intended for manual editing.
        version = 3

        [[package]]
        name = "${name}"
        version = "${version}"
      '';
    };

    #~@ Hermetic Binary (use in activation)
    binary = buildRustPackage {
      pname = name;
      inherit version;

      src = runCommand "${name}-src" {} ''
        mkdir -p $out/src
        cp ${script} $out/src/main.rs
        cp ${cargo.toml} $out/Cargo.toml
        cp ${cargo.lock} $out/Cargo.lock
      '';

      #? cargoLock and cargoHash are mutually exclusive.
      cargoLock.lockFile = cargo.lock;

      doCheck = true; #? runs the #[cfg(test)] tests in profile-name.rs
    };

    #~@ Dev Wrapper (use interactively)
    #? rust-script caches the compiled crate under $CARGO_HOME; first run pays.
    #? Not suitable for activation (sandbox).
    wrapper = posixBin "${name}-script" ''
      exec ${rust-script} ${script} "$@"
    '';
  in {
    inherit wrapper;
    package = binary;
    command = "${binary}/bin/${name}";
  };
}
