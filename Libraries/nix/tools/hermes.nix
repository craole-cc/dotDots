{_, ...}: let
  inherit (_.sources.access) getBin;
in {
  mkProfileValidator = pkgs: let
    inherit (pkgs) rustPlatform rust-script writeShellScriptBin writeText;

    #~@ Shared Identity
    name = "hermes-profile-validate";
    version = "0.1.0";
    edition = "2021";
    script = ./hermes-profile.rs;
    # TODO: Why is this not using binaries from toolkit?
    rs = "${getBin rust-script}/bin/rust-script";

    #~@ Build Inputs (derivations, not shell)
    #? Interpolated TOML values are quoted; writeText keeps heredoc indentation out of the generated files.
    cargo = {
      toml = writeText "Cargo.toml" ''
        [package]
        name = "${name}"
        version = "${version}"
        edition = "${edition}"

        [[bin]]
        name = "${name}"
        path = "src/main.rs"

        [profile.release]
        strip = true
        lto = true
        panic = "abort"
        codegen-units = 1
        opt-level = "z"
      '';

      #? Zero external crates -> trivial lockfile -> fully offline build.
      lock = writeText "Cargo.lock" ''
        # This file is automatically @generated by Cargo.
        # It is not intended for manual editing.
        version = 3

        [[package]]
        name = "${name}"
        version = "${version}"
      '';
    };

    #~@ Hermetic Binary (use in activation)
    binary = rustPlatform.buildRustPackage {
      pname = name;
      inherit version;

      src = pkgs.runCommand "${name}-src" {} ''
        mkdir -p $out/src
        cp ${script} $out/src/main.rs
        cp ${cargo.toml} $out/Cargo.toml
        cp ${cargo.lock} $out/Cargo.lock
      '';

      #? cargoLock and cargoHash are mutually exclusive.
      cargoLock.lockFile = cargo.lock;

      doCheck = true; #? runs the #[cfg(test)] tests in profile-name.rs
    };

    #~@ Dev Wrapper (use interactively)
    #? rust-script caches the compiled crate under $CARGO_HOME; first run pays.
    #? Not suitable for activation (sandbox).
    wrapper = writeShellScriptBin "${name}-script" ''
      exec ${rs} ${script} "$@"
    '';
  in {
    nameValidatePkg = binary;
    nameValidateBin = "${binary}/bin/${name}";
    nameValidateScr = wrapper;
  };
}
