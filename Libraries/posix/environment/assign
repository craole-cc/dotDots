#!/bin/sh
#| Standalone idempotent assignment helpers
#? Sourcing this file defines: assign_var, assign_path, and parse_arguments

assign_var() {
  eval "_av_val=\${$1:-}"
  [ -n "${_av_val}" ] && return 0
  eval "$1=\"\$2\""
}

assign_path() {
  _ap_target="$1"
  eval "_ap_val=\${${_ap_target}:-}"
  [ -n "${_ap_val}" ] && return 0
  shift

  if command -v join_path >/dev/null 2>&1; then
    _ap_result=$(join_path "$@")
  else
    _ap_result=""
    for _ap_seg in "$@"; do
      [ -z "${_ap_seg}" ] && continue
      case "${_ap_result}" in
      "") _ap_result="${_ap_seg}" ;;
      */) _ap_result="${_ap_result}${_ap_seg#/}" ;;
      *) _ap_result="${_ap_result}/${_ap_seg#/}" ;;
      esac
    done
  fi

  eval "${_ap_target}=\"\${_ap_result}\""
}

parse_arguments() {
  case "$1" in
  --var)
    shift
    assign_var "$@"
    ;;
  --path)
    shift
    assign_path "$@"
    ;;
  *)
    printf "assign: expected --var or --path, got '%s'\n" "${1:-<none>}" >&2
    return 1
    ;;
  esac
}

main() {
  parse_arguments "$@"
}

# ── Direct Execution Guard ───────────────────────────────────────────────
if [ "${0##*/}" = "assign" ]; then
  main "$@"
fi
