#!/bin/sh
#? Initialize Libraries directory structure

# ── Validate / Correct / Require DOTS ─────────────────────────────────────#? Validate existing DOTS directory; discard if dead.
if [ -n "${DOTS:-}" ] && [ ! -d "${DOTS}" ]; then
  printf "binit: WARNING - \$DOTS points to non-existent path '%s'. Resetting.\n" "${DOTS}" >&2
  unset DOTS
fi

#? 1. Attempt git resolution if inside a working tree
if [ -z "${DOTS:-}" ] && git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  DOTS=$(git rev-parse --show-toplevel 2> /dev/null || true)
  [ -n "${DOTS}" ] && printf "binit: WARNING - \$DOTS was unset; resolved via git to '%s'\n" "${DOTS}" >&2
fi

#? 2. Fallback: Strict multi-anchor upward directory traversal starting from $PWD
#? Failsafe requirement: .git, flake.nix, and .dotsrc MUST all exist together in the root.
if [ -z "${DOTS:-}" ]; then
  range_dir="${PWD:-$(pwd -P)}"
  while [ -n "${range_dir}" ] && [ "${range_dir}" != "/" ]; do
    if [ -d "${range_dir}/.git" ] && [ -f "${range_dir}/flake.nix" ] && [ -f "${range_dir}/.dotsrc" ]; then
      DOTS="${range_dir}"
      printf "binit: WARNING - \$DOTS was unset; discovered verified root anchor at '%s'\n" "${DOTS}" >&2
      break
    fi
    range_dir="${range_dir%/*}"
  done
  unset range_dir
fi

#? Final sanity check: Abort cleanly if root discovery failed
if [ -z "${DOTS:-}" ] || [ ! -d "${DOTS}" ]; then
  printf "binit: FATAL - Could not resolve \$DOTS via git or strict root anchors (.git AND flake.nix AND .dotsrc).\n" >&2
  if (return 0) 2> /dev/null; then return 1; else exit 1; fi
fi

# ── Bootstrap Assign Helpers ──────────────────────────────────────────────
#? Minimal fallback for assign_var: binds value if variable is currently unset.
if ! command -v assign_var > /dev/null 2>&1; then
  assign_var() {
    eval "_av_val=\${$1:-}"
    [ -n "${_av_val}" ] && return 0
    eval "$1=\"\$2\""
  }
fi

#? Minimal fallback for assign_path: joins atomic segments into a normalized path string.
if ! command -v assign_path > /dev/null 2>&1; then
  assign_path() {
    _ap_target="$1"
    eval "_ap_val=\${${_ap_target}:-}"
    [ -n "${_ap_val}" ] && return 0
    shift
    _ap_res=""
    for _ap_seg in "$@"; do
      [ -z "${_ap_seg}" ] && continue
      case "${_ap_res}" in
        "") _ap_res="${_ap_seg}" ;;
        */) _ap_res="${_ap_res}${_ap_seg#/}" ;;
        *) _ap_res="${_ap_res}/${_ap_seg#/}" ;;
      esac
    done
    eval "${_ap_target}=\"\${_ap_res}\""
  }
fi

# ── Configuration Defaults ────────────────────────────────────────────────
#> Assign default values using atomic segment joining for DOTS_LIB_SH.
#? Because DOTS is guaranteed to be set above, assign_path runs unconditionally.
assign_path DOTS_LIB_SH "${DOTS}" "Libraries" "posix"
assign_var BIN_DEPTH "10"
assign_var BIN_IGNORE "review tmp archive"
assign_var BLACKLIST_EXT "md txt json yaml yml xml html css js ts jsx tsx png jpg jpeg gif svg pdf doc docx xls xlsx ppt pptx zip tar gz bz2 7z log"
assign_var BINIT_ACTION "run"
assign_var BINIT_VERBOSITY "quiet"

#| Confirms DOTS_LIB_SH actually points somewhere before operating
require_lib_root() {
  if [ -z "${DOTS_LIB_SH:-}" ] || [ ! -d "${DOTS_LIB_SH}" ]; then
    printf "binit: DOTS_LIB_SH is not a valid directory (got: '%s').\n" "${DOTS_LIB_SH:-<unset>}" >&2
    printf "  Either export DOTS (the dotfiles repo root) before sourcing binit,\n" >&2
    printf "  or set DOTS_LIB_SH directly to the Libraries/posix path, e.g.:\n" >&2
    printf "    DOTS_LIB_SH=/path/to/dotDots/Libraries/posix . /path/to/dotDots/Libraries/posix/base/binit\n" >&2
    return 1
  fi
}

#| Builds candidate list for shebang inspection.
list_shebang_candidates() {
  out="$1"

  if command -v rg > /dev/null 2>&1; then
    _rg_glob=""
    # shellcheck disable=SC2154
    for dir in ${BIN_IGNORE}; do
      _rg_glob="${_rg_glob} --glob !**/${dir}/**"
    done
    #shellcheck disable=SC2086
    rg --files-with-matches --no-messages --hidden --no-ignore \
      --multiline --pcre2 ${_rg_glob} '\A#!' "${DOTS_LIB_SH}" > "${out}" 2> /dev/null
    printf "rg"
    return 0
  fi

  if command -v fd > /dev/null 2>&1; then
    _fd_exclude=""
    for dir in ${BIN_IGNORE}; do
      _fd_exclude="${_fd_exclude} --exclude ${dir}"
    done
    #shellcheck disable=SC2086
    fd --type f --hidden --no-ignore ${_fd_exclude} . "${DOTS_LIB_SH}" > "${out}" 2> /dev/null
    printf "fd"
    return 0
  fi

  _prune=""
  for dir in ${BIN_IGNORE}; do
    _prune="${_prune}${_prune:+ -o }-name ${dir}"
  done
  if [ -n "${_prune}" ]; then
    #shellcheck disable=SC2086
    find "${DOTS_LIB_SH}" \( -type d \( ${_prune} \) -prune \) -o -type f -print > "${out}" 2> /dev/null
  else
    find "${DOTS_LIB_SH}" -type f > "${out}" 2> /dev/null
  fi
  printf "find"
}

make_executable() {
  changed_count=0
  _file_list="$(mktemp)"

  _tier=$(list_shebang_candidates "${_file_list}")

  while IFS= read -r file; do
    [ -n "${file}" ] || continue
    [ -x "${file}" ] && continue

    ext="${file##*.}"
    # shellcheck disable=SC2154
    case " ${BLACKLIST_EXT} " in
      *" ${ext} "*) continue ;;
      *) ;;
    esac

    if [ "${_tier}" = "rg" ]; then
      chmod +x "${file}" 2> /dev/null && changed_count=$((changed_count + 1))
    else
      IFS= read -r first_line < "${file}" 2> /dev/null
      case "${first_line}" in
        "#!"*)
          chmod +x "${file}" 2> /dev/null && changed_count=$((changed_count + 1))
          ;;
        *) ;;
      esac
    fi
  done < "${_file_list}"

  rm -f "${_file_list}"

  [ "${changed_count}" -gt 0 ] \
    && printf "Made %s scripts executable\n" "${changed_count}" >&2
}

#> Add Libraries directories to PATH safely (eval-free & subshell-safe)
add_to_path() {
  DOTS_PATH=""
  dir_count=0
  _dir_list="$(mktemp)"

  if command -v fd > /dev/null 2>&1; then
    _fd_exclude=""
    for dir in ${BIN_IGNORE}; do
      _fd_exclude="${_fd_exclude} --exclude ${dir}"
    done
    #shellcheck disable=SC2086,SC2154
    fd --type d --max-depth $((BIN_DEPTH * 2)) ${_fd_exclude} . "${DOTS_LIB_SH}" > "${_dir_list}" 2> /dev/null
  else
    _prune=""
    for dir in ${BIN_IGNORE}; do
      _prune="${_prune}${_prune:+ -o }-name ${dir}"
    done
    if [ -n "${_prune}" ]; then
      #shellcheck disable=SC2086
      find "${DOTS_LIB_SH}" -maxdepth "${BIN_DEPTH}" \( -type d \( ${_prune} \) -prune \) -o -type d -print > "${_dir_list}" 2> /dev/null
    else
      find "${DOTS_LIB_SH}" -maxdepth "${BIN_DEPTH}" -type d > "${_dir_list}" 2> /dev/null
    fi
  fi

  while IFS= read -r dir; do
    [ -n "${dir}" ] && [ -d "${dir}" ] || continue

    case ":${PATH}:${DOTS_PATH}:" in
      *:"${dir}":*) ;;
      *)
        DOTS_PATH="${DOTS_PATH:+"${DOTS_PATH}:"}${dir}"
        dir_count=$((dir_count + 1))
        ;;
    esac
  done < "${_dir_list}"

  rm -f "${_dir_list}"

  if [ -n "${DOTS_PATH}" ]; then
    PATH="${DOTS_PATH}:${PATH}"
    export PATH
    case "${BINIT_VERBOSITY:-}" in
      quiet) ;;
      *) printf "Added %s directories to PATH\n" "${dir_count}" >&2 ;;
    esac
  fi
}

#> Main initialization
binit() {
  require_lib_root || return 1
  make_executable
  add_to_path
}

#> Execute based on BINIT_ACTION
dispatch() {
  case "${1:-${BINIT_ACTION}}" in
    run | --run | "")
      binit
      ;;
    executable | --executable)
      require_lib_root || return 1
      make_executable
      ;;
    path | --path)
      require_lib_root || return 1
      add_to_path
      ;;
    *)
      printf "Usage: Set BINIT_ACTION to run, executable, or path\n" >&2
      ;;
  esac
}

#> ALWAYS run dispatch when sourced
dispatch

#> Keep this for direct execution compatibility
if [ "${0##*/}" = "binit" ]; then
  exit 0
fi
