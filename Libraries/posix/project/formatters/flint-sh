#!/bin/sh
# flint-sh – shellcheck + shfmt in one pass, with real autofix.
#
# Each file is processed on a scratch copy that lives next to the original
# (so .shellcheckrc / .editorconfig discovery keeps working):
#   1. shfmt
#   2. shellcheck -f diff | patch   (ShellCheck's own suggested fixes)
#   3. built-in fixers for things ShellCheck can't fix by itself:
#        SC3014  [ a == b ]   ->  [ a = b ]
#        SC2166  [ a -a b ]   ->  [ a ] && [ b ]      (-o -> ||)
#        SC2249  case ... esac -> case ... *) ;; esac (default; --no-default-case)
#        SC2154  $var         ->  ${var:?}            (opt-in: --guard-vars)
#   4. repeat 1-3 until nothing changes (bounded by MAX_PASSES)
#   5. write back only if something changed (--dry-run shows a diff instead)
#   6. print whatever ShellCheck still complains about
#
# Exit status: 0 clean | 1 issues remain (or changes pending in --dry-run) | 2 usage error

set -eu

#~@ Global Settings & Defaults
_scr_name="flint-sh"
INDENT_SIZE=2
DRY_RUN=0
GUARD_VARS=0
DEFAULT_CASE=1
DETECT_SHELL=0
IS_SHELL=0
INTERNAL_MODE=0
MAX_PASSES=5
NPROC=2
FINDER=""
SCRIPT_PATH=""
COLOR="auto"
TMP_FILE=""
TMP_DIR=""

#~@ Helpers
die() {
  printf '%s: %s\n' "${_scr_name}" "$*" >&2
  exit 2
}

usage() {
  printf 'Usage: %s [options] <file|dir>...\n\n' "${0##*/}"
  printf 'Options:\n'
  printf '  -i, --indent NUM   shfmt indent size (default: 2)\n'
  printf '  -d, --dry-run      show a diff of the fixes and the issues that would remain\n'
  # shellcheck disable=SC2016
  printf '  -g, --guard-vars   rewrite unassigned variables (SC2154) to the ${var:?} form\n'
  printf '  -D, --no-default-case\n'
  printf '                     do not add a catch-all "*) ;;" to case statements (SC2249)\n'
  printf '  -s, --detect-shell only touch files that are shell scripts (known extension or shell\n'
  printf '                     shebang), even when named explicitly - for tools like treefmt\n'
  printf '                     that hand over every file matching a glob\n'
  printf '  -h, --help         show this help menu\n\n'
  printf 'Exit status: 0 clean, 1 issues remain (or changes pending with -d), 2 usage error\n'
}

cleanup() {
  if [ -n "${TMP_DIR}" ]; then
    rm -rf "${TMP_DIR}"
  fi
  TMP_DIR=""
  TMP_FILE=""
}

#~@ Tool Discovery & Parallel Config
init_bin() {
  for _tool in shellcheck shfmt patch; do
    command -v "${_tool}" >/dev/null 2>&1 || die "required tool not found: ${_tool}"
  done

  # CPU threads for parallel processing (POSIX fallback to 2)
  NPROC=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)

  # Fast finder with a plain find(1) fallback
  if command -v fd >/dev/null 2>&1; then
    FINDER="fd"
  elif command -v fdfind >/dev/null 2>&1; then
    FINDER="fdfind"
  else
    FINDER="find"
  fi

  # Honour NO_COLOR; otherwise let shellcheck decide based on the tty
  if [ -n "${NO_COLOR:-}" ]; then
    COLOR="never"
  fi

  # Absolute path to ourselves, for the parallel workers
  case $0 in
  /*) SCRIPT_PATH=$0 ;;
  */*)
    _ib_dir=$(dirname -- "$0")
    _ib_dir=$(cd -- "${_ib_dir}" && pwd)
    SCRIPT_PATH="${_ib_dir}/${0##*/}"
    ;;
  *) SCRIPT_PATH=$(command -v -- "$0" || readlink -f -- "$0") ;;
  esac
}

#~@ Is this a shell script? (sets IS_SHELL to 1/0; always returns 0)
# Known extension, or a shebang naming a shell (directly or through env).
is_shell_file() {
  IS_SHELL=0
  case $1 in
  *.sh | *.bash | *.ksh | *.bats)
    IS_SHELL=1
    return 0
    ;;
  *) ;;
  esac

  # First 256 bytes, NULs stripped so binaries can't upset the shell; no
  # early-exiting reader, so this stays safe under pipefail.
  _isf_nl='
'
  _isf_line=$(dd if="$1" bs=256 count=1 2>/dev/null | tr -d '\000') || return 0
  _isf_line=${_isf_line%%"${_isf_nl}"*}
  case ${_isf_line} in "#!"*) ;; *) return 0 ;; esac

  _isf_rest=${_isf_line#"#!"}
  set -f
  # shellcheck disable=SC2086
  set -- ${_isf_rest}
  set +f

  _isf_prog=${1:-}
  _isf_prog=${_isf_prog##*/}
  if [ "${_isf_prog}" = "env" ]; then
    if [ $# -gt 0 ]; then shift; fi
    while [ $# -gt 0 ]; do
      case $1 in
      -* | *=*) shift ;;
      *) break ;;
      esac
    done
    _isf_prog=${1:-}
    _isf_prog=${_isf_prog##*/}
  fi

  case ${_isf_prog} in
  sh | bash | dash | ash | ksh | mksh | oksh) IS_SHELL=1 ;; *) ;;
  esac
}

#~@ Fixers (all operate in place on the scratch copy)
run_shfmt() {
  shfmt \
    --apply-ignore \
    --binary-next-line \
    --space-redirects \
    --case-indent \
    --indent "${INDENT_SIZE}" \
    --write \
    "$1" 2>/dev/null
}

# Apply ShellCheck's own fixes. The target is passed to patch explicitly, so
# the paths in the diff header (absolute or relative) don't matter.
apply_shellcheck_diff() {
  _asd_diff=$(shellcheck -f diff "$1" 2>/dev/null) || true
  [ -n "${_asd_diff}" ] || return 0
  printf '%s\n' "${_asd_diff}" | patch -s "$1" >/dev/null 2>&1 || true
  rm -f "$1.orig" "$1.rej"
}

# sed_line FILE LINE EXPR – run a sed expression on one line, in place
sed_line() {
  _sl_tmp="$1.sedtmp"
  sed "$2$3" "$1" >"${_sl_tmp}" && cat "${_sl_tmp}" >"$1"
  rm -f "${_sl_tmp}"
}

# SC2166: only rewrite the unambiguous case – a single [ ... ] holding either
# -a or -o (never both, since -a binds tighter than -o), no negation/grouping.
fix_sc2166() {
  _f_file=$1
  _f_line=$2
  _f_text=$(sed -n "${_f_line}p" "${_f_file}")

  case ${_f_text} in
  *'!'* | *'[['* | *'\('*) return 0 ;;
  *) ;;
  esac

  _f_brackets=$(printf '%s' "${_f_text}" | tr -cd '[' | wc -c)
  [ "$((_f_brackets))" -eq 1 ] || return 0

  _f_has_a=0
  _f_has_o=0
  case ${_f_text} in *' -a '*) _f_has_a=1 ;; *) ;; esac
  case ${_f_text} in *' -o '*) _f_has_o=1 ;; *) ;; esac
  [ "$((_f_has_a + _f_has_o))" -eq 1 ] || return 0

  if [ "${_f_has_a}" -eq 1 ]; then
    sed_line "${_f_file}" "${_f_line}" 's/\[ \(.*\) -a \(.*\) ]/[ \1 ] \&\& [ \2 ]/'
  else
    sed_line "${_f_file}" "${_f_line}" 's/\[ \(.*\) -o \(.*\) ]/[ \1 ] || [ \2 ]/'
  fi
}

# SC2249: add a catch-all `*) ;;` in front of the closing esac.
# ShellCheck reports the span of the whole case statement, so endLine/endColumn
# point just past the matching esac, which keeps nested cases unambiguous.
# Edits run bottom-up so earlier line numbers stay valid; shfmt re-indents the
# new clause on the next pass. Each edit is parse-checked and rolled back on failure.
fix_sc2249() {
  _dc_file=$1
  _dc_bak="${_dc_file}.dcbak"
  _dc_tab=$(printf '\t')
  _dc_nl='
'

  _dc_hits=$(
    shellcheck -f json "${_dc_file}" 2>/dev/null |
      tr '{' '\n' |
      sed -n 's/.*"endLine":\([0-9][0-9]*\),"column":[0-9][0-9]*,"endColumn":\([0-9][0-9]*\),.*"code":2249,.*/\1 \2/p' |
      sort -k1,1nr -k2,2nr
  ) || true
  [ -n "${_dc_hits}" ] || return 0

  printf '%s\n' "${_dc_hits}" | while read -r _dc_line _dc_col; do
    _dc_text=$(sed -n "${_dc_line}p" "${_dc_file}")
    _dc_lead=$(printf '%s' "${_dc_text}" | sed 's/^[[:space:]]*//')
    _dc_tmp="${_dc_file}.sedtmp"
    cp -- "${_dc_file}" "${_dc_bak}"

    case ${_dc_lead} in
    'esac' | 'esac'[!A-Za-z0-9_]*)
      # esac opens its line: add the clause on its own line above it
      sed "${_dc_line}i\\${_dc_nl}*) ;;" "${_dc_file}" >"${_dc_tmp}" &&
        cat "${_dc_tmp}" >"${_dc_file}"
      ;;
    *)
      # one-liner (... ;; esac): splice in front of the esac using its column.
      # ShellCheck expands tabs in columns, so leave tabbed lines alone.
      case ${_dc_text} in *"${_dc_tab}"*) continue ;; *) ;; esac
      _dc_pre=$((_dc_col - 5))
      [ "${_dc_pre}" -ge 0 ] || continue
      sed "${_dc_line}s/^\\(.\\{${_dc_pre}\\}\\)esac/\\1*) ;; esac/" "${_dc_file}" >"${_dc_tmp}" &&
        cat "${_dc_tmp}" >"${_dc_file}"
      ;;
    esac
    rm -f "${_dc_tmp}"

    # Roll back if the result no longer parses (e.g. last clause lacked its ;;)
    shfmt "${_dc_file}" >/dev/null 2>&1 || cp -- "${_dc_bak}" "${_dc_file}"
  done
  rm -f "${_dc_bak}"
}

# SC2154 -> ${var:?}  (opt-in: it changes runtime behaviour)
guard_unassigned_vars() {
  _gv_file=$1
  _gv_vars=$(
    shellcheck -f gcc "${_gv_file}" 2>/dev/null |
      sed -n 's/^.*warning: \([A-Za-z_][A-Za-z0-9_]*\) is referenced but not assigned.*$/\1/p' |
      sort -u
  ) || true

  for _gv_var in ${_gv_vars}; do
    _gv_tmp="${_gv_file}.sedtmp"
    sed \
      -e 's/[$][{]'"${_gv_var}"'[}]/${'"${_gv_var}"':?}/g' \
      -e 's/[$]'"${_gv_var}"'\([^A-Za-z0-9_]\)/${'"${_gv_var}"':?}\1/g' \
      -e 's/[$]'"${_gv_var}"'$/${'"${_gv_var}"':?}/' \
      "${_gv_file}" >"${_gv_tmp}" && cat "${_gv_tmp}" >"${_gv_file}"
    rm -f "${_gv_tmp}"
  done
}

fix_extra() {
  _fx_file=$1
  _fx_hits=$(
    shellcheck -f gcc "${_fx_file}" 2>/dev/null |
      sed -n 's/^.*:\([0-9][0-9]*\):[0-9][0-9]*: [a-z]*: .*\[\(SC[0-9]*\)\]$/\1 \2/p' |
      sort -u
  ) || true

  if [ -n "${_fx_hits}" ]; then
    printf '%s\n' "${_fx_hits}" | while read -r _fx_line _fx_code; do
      case ${_fx_code} in
      SC3014) sed_line "${_fx_file}" "${_fx_line}" 's/ == / = /' ;;
      SC2166) fix_sc2166 "${_fx_file}" "${_fx_line}" ;;
      *) ;;
      esac
    done
  fi

  if [ "${DEFAULT_CASE}" -eq 1 ]; then
    fix_sc2249 "${_fx_file}"
  fi

  if [ "${GUARD_VARS}" -eq 1 ]; then
    guard_unassigned_vars "${_fx_file}"
  fi
}

# Run every fixer repeatedly until the file stops changing
fix_file() {
  _ff_file=$1
  _ff_pass=0
  while [ "${_ff_pass}" -lt "${MAX_PASSES}" ]; do
    _ff_before=$(cksum <"${_ff_file}")
    set +e
    run_shfmt "${_ff_file}"
    _ff_rc=$?
    set -e
    [ "${_ff_rc}" -eq 0 ] || return 1
    apply_shellcheck_diff "${_ff_file}"
    fix_extra "${_ff_file}"
    _ff_after=$(cksum <"${_ff_file}")
    [ "${_ff_before}" != "${_ff_after}" ] || break
    _ff_pass=$((_ff_pass + 1))
  done
  run_shfmt "${_ff_file}"
}

#~@ Per-file driver
process_file() {
  _pf_orig=$1
  [ -f "${_pf_orig}" ] || return 0

  _pf_dir=$(dirname -- "${_pf_orig}")
  _pf_base=$(basename -- "${_pf_orig}")
  # The scratch copy keeps the original file NAME, in a sibling directory:
  #  - shfmt --apply-ignore silently skips hidden files and files whose
  #    extension it doesn't recognise, so we can't decorate the filename
  #  - a child of the original directory still inherits .shellcheckrc/.editorconfig
  TMP_DIR="${_pf_dir}/flint-sh-tmp.$$"
  TMP_FILE="${TMP_DIR}/${_pf_base}"

  if ! mkdir -p -- "${TMP_DIR}" 2>/dev/null || ! cp -p -- "${_pf_orig}" "${TMP_FILE}" 2>/dev/null; then
    printf '%s: cannot create scratch copy next to %s\n' "${_scr_name}" "${_pf_orig}" >&2
    cleanup
    return 1
  fi

  set +e
  fix_file "${TMP_FILE}"
  _pf_rc=$?
  set -e
  if [ "${_pf_rc}" -ne 0 ]; then
    printf '%s: %s: could not be parsed, skipped\n' "${_scr_name}" "${_pf_orig}" >&2
    shellcheck --color="${COLOR}" "${_pf_orig}" || true
    cleanup
    return 1
  fi

  _pf_status=0
  _pf_changed=0
  cmp -s "${_pf_orig}" "${TMP_FILE}" || _pf_changed=1

  if [ "${DRY_RUN}" -eq 1 ]; then
    if [ "${_pf_changed}" -eq 1 ]; then
      diff -u -L "${_pf_orig}" -L "${_pf_orig} (fixed)" "${_pf_orig}" "${TMP_FILE}" || true
      _pf_status=1
    fi
    _pf_left=$(shellcheck -f gcc "${TMP_FILE}" 2>/dev/null || true)
    if [ -n "${_pf_left}" ]; then
      printf 'flint-sh [dry-run]: issues that would remain in %s:\n' "${_pf_orig}"
      printf '%s\n' "${_pf_left}" | sed "s|^[^:]*|${_pf_orig}|"
      _pf_status=1
    fi
  else
    if [ "${_pf_changed}" -eq 1 ]; then
      cat "${TMP_FILE}" >"${_pf_orig}"
      printf 'flint-sh: fixed %s\n' "${_pf_orig}"
    fi
    shellcheck --color="${COLOR}" "${_pf_orig}" || _pf_status=1
  fi

  cleanup
  return "${_pf_status}"
}

#~@ Directory walking: find -> keep shell scripts -> fan out to workers
run_finder() {
  _rf_dir=$1

  set -- xargs -0 -P "${NPROC}" -n 20
  if [ -x "${SCRIPT_PATH}" ]; then
    set -- "$@" "${SCRIPT_PATH}"
  else
    set -- "$@" sh "${SCRIPT_PATH}"
  fi
  set -- "$@" -i "${INDENT_SIZE}"
  if [ "${DRY_RUN}" -eq 1 ]; then set -- "$@" -d; fi
  if [ "${GUARD_VARS}" -eq 1 ]; then set -- "$@" -g; fi
  if [ "${DEFAULT_CASE}" -eq 0 ]; then set -- "$@" -D; fi
  set -- "$@" --internal-process

  case ${FINDER} in
  fd | fdfind)
    "${FINDER}" --type f --print0 . "${_rf_dir}" | "$@"
    ;;
  *)
    find "${_rf_dir}" \( -name .git -o -name node_modules \) -prune -o -type f -print0 | "$@"
    ;;
  esac
}

#~@ Entry Point
main() {
  init_bin
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP

  while [ $# -gt 0 ]; do
    case $1 in
    --internal-process)
      INTERNAL_MODE=1
      shift
      break
      ;;
    -i | --indent)
      [ $# -ge 2 ] || die "option requires a value: $1"
      INDENT_SIZE=$2
      shift 2
      ;;
    -d | --dry-run)
      DRY_RUN=1
      shift
      ;;
    -s | --detect-shell)
      DETECT_SHELL=1
      shift
      ;;
    -g | --guard-vars)
      GUARD_VARS=1
      shift
      ;;
    -D | --no-default-case)
      DEFAULT_CASE=0
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -?*) die "unknown option: $1" ;;
    *) break ;;
    esac
  done

  case ${INDENT_SIZE} in
  '' | *[!0-9]*) die "indent must be a number, got: ${INDENT_SIZE}" ;; *) ;;
  esac

  _main_rc=0

  #> Route 1: internal worker – a batch of paths found by run_finder
  if [ "${INTERNAL_MODE}" -eq 1 ]; then
    for _file in "$@"; do
      # skip our own scratch dirs if the finder raced with a worker
      case /${_file} in */flint-sh-tmp.*/*) continue ;; *) ;; esac
      is_shell_file "${_file}"
      [ "${IS_SHELL}" -eq 1 ] || continue
      set +e
      process_file "${_file}"
      _main_st=$?
      set -e
      [ "${_main_st}" -eq 0 ] || _main_rc=1
    done
    exit "${_main_rc}"
  fi

  [ $# -gt 0 ] || {
    usage >&2
    exit 2
  }

  #> Route 2: public interface – files are always processed, dirs are walked
  for _arg in "$@"; do
    if [ -d "${_arg}" ]; then
      set +e
      run_finder "${_arg}"
      _main_st=$?
      set -e
      [ "${_main_st}" -eq 0 ] || _main_rc=1
    elif [ -f "${_arg}" ]; then
      if [ "${DETECT_SHELL}" -eq 1 ]; then
        is_shell_file "${_arg}"
        [ "${IS_SHELL}" -eq 1 ] || continue
      fi
      set +e
      process_file "${_arg}"
      _main_st=$?
      set -e
      [ "${_main_st}" -eq 0 ] || _main_rc=1
    else
      printf '%s: skipping non-existent path: %s\n' "${_scr_name}" "${_arg}" >&2
      _main_rc=1
    fi
  done

  exit "${_main_rc}"
}

main "$@"
