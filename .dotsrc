#nu     exit 1
#nu }
#nu
#nu if not ($env.DOTS | path exists) {
#nu     print --error $"Missing DOTS directory: ($env.DOTS)"
#nu     exit 1
#nu }
#nu
#nu let dots_env = ($env.DOTS | path join "Environment" "_.nu")
