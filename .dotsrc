# === POSIX SHELLS (bash, zsh, sh) ===
#~@ Load the DOTS environment
posix_env="./Environment/posix/dots.sh"

# shellcheck disable=SC1090
if [ -f "${posix_env}" ]; then
  . "${posix_env}"
else
  printf \
    "WARNING: %s missing' -- skipping library init\n" \
    "${posix_env}" >&2
fi

#~@ Exit with the last exit code
return "$?"

# === POWERSHELL ===
#requires -Version 5.1
$InitTime = Get-Date

if (-not $env:DOTS) {
  Throw "DOTS variable is unset. It must point to the DOTS (dotfiles) directory."
}

if (-not (Test-Path -Path $env:DOTS -PathType Container)) {
  Throw "Missing DOTS directory: $env:DOTS"
}

$dotsEnv = [IO.Path]::Combine($env:DOTS, 'Configuration', 'powershell', 'profile.psm1')
if (-not (Test-Path -Path $dotsEnv -PathType Leaf)) {
  Throw "Missing required configuration module: ${dotsEnv}"
} else {
  Write-Debug "Loading $dotsEnv -Verbose"
  Import-Module $dotsEnv -Force
  if (Get-Command 'Write-Pretty' -ErrorAction SilentlyContinue) {
    Write-Pretty -Tag 'Info' -As 'dotDOTS' -Init $InitTime
  } else {
    Write-Host "dotDOTS loaded (timing: $((Get-Date) - $InitTime)" -ForegroundColor Green
  }
}
