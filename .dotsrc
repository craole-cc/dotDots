# shellcheck disable=SC2148,SC2292,SC1090
# ===========================================================================
# DOTS RC - Universal shell configuration loader for DOTS
# Supports: bash, zsh, sh, fish, PowerShell, Nushell
# ===========================================================================

# === NUSHELL ===
